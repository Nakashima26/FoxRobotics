[Unit]
Description=FoxRobotics Remote Desktop Client
After=network-online.target graphical-session.target
Wants=network-online.target graphical-session.target

[Service]
Type=simple
User=user
Environment=REMOTE_SERVER=ws://100.80.180.4:8765
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/user/.Xauthority
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/user/FoxRobotics/.venv/bin/python /home/user/FoxRobotics/remote/client.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
