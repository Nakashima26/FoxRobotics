[Unit]
Description=FoxRobotics WRO runtime
After=network-online.target dev-serial0.device
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/FoxRobotics
ExecStart=/home/user/FoxRobotics/.venv/bin/python /home/user/FoxRobotics/src/RASPI/cam/wro_runtime.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target